 "statistics": {
  "binary": "exact two-sided binomial on discordant roots",
  "ci": "paired root-cluster bootstrap 95 % (2,000 resamples, seed 0); seeds reported individually; arm value per root = seed mean",
  "equivalence": "never claimed from a CI crossing 0",
  "multiplicity": "Holm over P1-P4 primary contrasts at alpha 0.05 (each P has one primary contrast; P1 uses B vs SF as its primary)",
  "power_note": "P10a per-root NLL SD ~ 0.96 -> ~29 roots for 0.5 nat at 80 %; per-mechanism blind counts 4-9 here will remain UNDERPOWERED for small effects",
  "power_rule": "< 5 decided independent roots = UNDERPOWERED (descriptive only); >= 10 recommended"
 },
 "statuses": "VERIFIED (1) / CERTIFIED (0, independently checked, scoped) / BUDGET (operational 0) / UNKNOWN, NOT_RUN, INELIGIBLE (missing). proof_grounded = all components VERIFIED or CERTIFIED; operational = >= 1 BUDGET.",
 "teacher_execution_policy": {
  "adjudication": "unchanged 2D-ABC-OPNEG-v1 (teacher_opneg.toml); BUDGET only if all 3 declared seeds ran to a clean allowed terminal",
  "chosen": "B_FULL_SEEDS",
  "options_predeclared": {
   "A_P10A": "120 CPU-s per query (later seed only while spent + 110 <= 120)",
   "B_FULL_SEEDS": "330 CPU-s per query: all three 100 CPU-s seeds fit; a censored seed ends the query (UNKNOWN)"
  },
  "query_cpu_s": 330.0,
  "query_wall_s": 900.0,
  "reserve_s": 10.0,
  "root_cpu_s": 900.0,
  "seed_cpu_s": 100.0,
  "seed_kill_margin_s": 5.0,
  "stop_after_censored_seed": true,
  "version": "P10B_S100_V1",
  "workers": 1
 },
 "teacher_policy": "P10B_S100_V1 (p10b_dataset.POLICY): OPNEG-v1 adjudication; seeds 100 CPU-s (kill 95), query 330 CPU-s / 900 s, root 900 CPU-s, a censored seed ends the query (UNKNOWN), one worker; option B_FULL_SEEDS chosen before labels",
 "total_roots": 180,
 "training": {
  "batch": 12,
  "optimizer": "AdamW 1e-3 / 1e-4, clip 10",
  "priority": [
   "full A/B/C/SF x3",
   "short A/B/C/SF x3",
   "D, D-pairless x3",
   "B-F2 order-invariant",
   "B-F4 no omission pair",
   "B-F5 structured (no generic + HO)",
   "B-F5 quadratic (no HO)",
   "B-F3 no scene pair",
   "B visual-zero",
   "B unique ontology",
   "J head / analytic static (selection-only, no retraining)"
  ],
  "rule": "ablations run in priority order while the training cap allows; the rest NOT_RUN",
  "seeds": [
   0,
   1,
   2
  ],
  "selection": "validation own-likelihood NLL every 20 updates (P10b validation roots)",
  "updates": 400
 },
