 "contract_sha256": "sha256:1a24b29cde0732eaa80b14d23b6aca8294309095716369e307078e2cf29f0f32",
 "endpoints": {
  "D_primary": "blind complete masks: per-object blocker F1 (macro by root), D vs D-pairless; secondary: vs heuristic; D feasibility AUROC / NLL vs A/B/C/SF z0 on matched roots",
  "P1_TOP1": "blind obstructed roots: strict TOP1_COMMIT executed success (target + SAFE_RETREAT), paired by root; contrasts B vs SF, C vs SF, A vs SF, B vs geometry-only; G+M = planner-assisted reference (not in the Holm family)",
  "P2_H1": "blind proof-grounded H1 four-tuples: |kappa_hat - kappa| per root, B vs A",
  "P3_ORDER": "blind proof-grounded same-endpoint order pairs (H3 + H10 permutations): order choice correct, C vs B",
  "P4_OMISSION": "blind decided leave-one-out omissions of witnessed repairs (H4, H10): necessity accuracy, B vs SF",
  "secondary": "common per-event NLL / accuracy / AUROC / Brier / ECE (root-prior marginals), kappa signs, H5 false-empty, H6 J, H7 edit-vs-executable sign, H9 appearance invariance, length extrapolation (short vs full on 3-/4-move), TOP5 (planner-assisted, never mixed with TOP1), complexity / coverage"
 },
 "execution": {
  "TOP1_COMMIT": "one learned choice from the frozen catalogue (identity check, analytic static veto, calibrated admission, fewest moves, J, C_d, energy); one seeded episode of that repair + target + SAFE_RETREAT; no fallback; abstain = failure",
  "TOP5_PRECOMMIT": "secondary, planner-assisted, separate table",
  "baselines": [
   "geometry-only TOP1 (analytic proposer, no planner ranking)",
   "G+M (planner-assisted)",
   "uniform"
  ],
  "cache": "identical (root, committed repair, episode seed) = one physical episode"
 },
 "families": "P10B_FAMILIES_V1 (p10b_scenes.py): H1, H2a (kappa-1), H2b (kappa0), H3, H4, H5 reused from P10A_MECHANISMS_V1; new H7 (enclosed destination), H8 (sweep barrier only, sector checker), H10_3 (grasp chain), H10_4 (chain + sweep barrier). Certificate-targeted construction is ADAPTIVE (sound static checkers, never teacher labels); H8 is accepted by the sector checker only (no pose screens). H9 = appearance variants (palette change, identical geometry) of validation and blind roots; labels reused by exact physical identity (not new observations).",
 "frozen_models": {
  "A": "LOCAL-SEQUENCE GRU (abc8 'A'), factorized objective",
  "B": "ABC9K_KEYED_V1 B-full (prefix / predecessor)",
  "C": "ABC9K_KEYED_V1 C-full (GRU order, replaces B's predecessor factor)",
  "D": "D_BLOCKERS_V1 (d_blockers.py)",
  "SF": "factorized supervised control (abc8 'SF')",
  "inputs": "frozen mask-pooled DINOv2-small + object geometry + robot q0 + goal"
 },
 "gates": {
  "P10b-0": "audit PASS; D synthetic tests PASS; prereg hashed + pushed before roster labels; 0 physical calls in learned inference; split / seed roster frozen",
  "P10b-1": "GO iff >= 70 % of required-contrast queries decided; >= 1 proof-grounded H1 and H3 root; >= 2 witnessed 3-move and >= 2 witnessed 4-move roots (else H10 BLOCKED, others continue); >= 50 % complete D masks among roots with a D pool; caps held",
  "P10b-2": "per 35-root batch: caps held, no FATAL; yield / power recomputed on non-blind only",
  "P10c": "all priority-1 runs finite; predictions + calibration frozen and committed before unsealing"
 },
